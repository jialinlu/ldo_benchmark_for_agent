{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable LDO design candidate",
  "type": "object",
  "required": ["schema_version", "candidate_id", "parent_id", "created_at", "candidate_digest", "files"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "candidate_id": {"type": "string", "minLength": 1},
    "parent_id": {"type": "string"},
    "created_at": {"type": "string"},
    "candidate_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "files": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
  }
}
