{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LDO design-closure qualification result",
  "type": "object",
  "required": ["schema_version", "candidate_id", "candidate_digest", "qualified", "promotion_status", "gates", "stale_evidence_gates", "unknown_gates"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "candidate_id": {"type": ["string", "null"]},
    "candidate_digest": {"type": "string"},
    "qualified": {"type": "boolean"},
    "promotion_status": {"enum": ["QUALIFIED", "BLOCKED"]},
    "gates": {"type": "object"},
    "stale_evidence_gates": {"type": "array", "items": {"type": "string"}},
    "unknown_gates": {"type": "array", "items": {"type": "string"}}
  }
}
