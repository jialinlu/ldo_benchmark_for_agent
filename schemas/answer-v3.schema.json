{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvoLDO v0.7 structured engineering answer",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "artifact", "claim_boundary", "confidence"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "task_id": {"type": "string", "minLength": 1},
    "artifact": {"type": "object", "minProperties": 1},
    "claim_boundary": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
