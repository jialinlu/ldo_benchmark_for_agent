{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvoLDO-Bench rollout telemetry",
  "type": "object",
  "required": ["schema_version", "task_id", "model_id", "mode", "rollout", "seed", "steps", "tool_calls", "wall_seconds", "token_breakdown", "cost_breakdown_usd"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "minLength": 1},
    "rollout": {"type": "integer", "minimum": 0},
    "seed": {"type": "integer", "minimum": 0},
    "steps": {"type": "integer", "minimum": 0},
    "tool_calls": {"type": "integer", "minimum": 0},
    "wall_seconds": {"type": "number", "minimum": 0},
    "token_breakdown": {"$ref": "#/$defs/breakdown"},
    "cost_breakdown_usd": {"$ref": "#/$defs/breakdown"},
    "token_measurement_status": {"enum": ["measured", "partial", "unavailable"]},
    "cost_measurement_status": {"enum": ["measured", "partial", "unavailable"]},
    "provider_reported_model_id": {"type": ["string", "null"]},
    "model_identity_status": {"enum": ["attested", "requested_only", "mismatch", "unavailable"]},
    "provider_total_cost_usd": {"type": ["number", "null"], "minimum": 0},
    "infra_status": {"enum": ["ok", "infra_fail", "not_used"]},
    "source": {"type": "string"},
    "probe_calls": {"type": "integer", "minimum": 0},
    "ineffective_probe_calls": {"type": "integer", "minimum": 0},
    "policy_rejected_probe_calls": {"type": "integer", "minimum": 0},
    "milestones": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "first_feasible_seconds": {"type": ["number", "null"], "minimum": 0},
        "terminal_seconds": {"type": ["number", "null"], "minimum": 0},
        "first_feasible_tokens": {"type": ["number", "null"], "minimum": 0},
        "terminal_tokens": {"type": ["number", "null"], "minimum": 0},
        "terminal_status": {"enum": ["completed", "model_declined", "model_incomplete", "format_fail", "infra_fail", "timeout"]}
      }
    }
  },
  "$defs": {
    "breakdown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": {"type": ["number", "null"], "minimum": 0},
        "cached_input": {"type": ["number", "null"], "minimum": 0},
        "output": {"type": ["number", "null"], "minimum": 0},
        "reasoning": {"type": ["number", "null"], "minimum": 0},
        "cache_write": {"type": ["number", "null"], "minimum": 0}
      }
    }
  }
}
