{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jialinlu/ldo_benchmark_for_agent/schemas/task.schema.json",
  "title": "EvoLDO-Bench task",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "task_id", "family_id", "lineage_id", "split", "variant", "suite", "level", "capabilities", "title", "language", "prompt_file", "input_files", "answer_template_file", "eligible_modes", "budget"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1},
    "lineage_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["dev", "validation", "test", "sealed"]},
    "variant": {"enum": ["canonical", "metamorphic", "counterexample", "regime", "difficulty"]},
    "suite": {"enum": ["structure", "trend", "diagnosis", "sizing", "migration", "system_impact", "design_closure", "architecture_choice"]},
    "level": {"enum": ["L1", "L2", "L3", "L4", "L5"]},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "title": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "prompt_file": {"type": "string", "minLength": 1},
    "input_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "answer_template_file": {"type": "string", "minLength": 1},
    "eligible_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["direct_reasoning", "agentic_skill", "simulation_assisted", "full_design", "weak_agent_airgap"]}},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "max_tool_calls"],
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "max_tool_calls": {"type": "integer", "minimum": 0}
      }
    }
  }
}
