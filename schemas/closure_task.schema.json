{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/evoldo/closure-task.schema.json",
  "title": "EvoLDO public-PDK closure task",
  "type": "object",
  "required": ["schema_version", "task_id", "pdk", "simulator", "title", "objective", "starter_candidate", "scenarios"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "pdk": {"const": "sky130"},
    "simulator": {"const": "ngspice"},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "injected_fault": {"type": "string", "minLength": 1},
    "starter_candidate": {"type": "string", "minLength": 1},
    "candidate_subckt": {"type": "string", "minLength": 1},
    "candidate_pin_order": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "hard_rules": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scenario_id", "corner", "temperature_c", "bench_template", "limits"],
        "properties": {
          "scenario_id": {"type": "string", "minLength": 1},
          "corner": {"enum": ["tt", "ff", "ss", "fs", "sf"]},
          "temperature_c": {"type": "number"},
          "bench_template": {"type": "string", "minLength": 1},
          "limits": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "properties": {"min": {"type": "number"}, "max": {"type": "number"}},
              "anyOf": [{"required": ["min"]}, {"required": ["max"]}],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
