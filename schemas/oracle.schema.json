{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jialinlu/ldo_benchmark_for_agent/schemas/oracle.schema.json",
  "title": "EvoLDO-Bench deterministic oracle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "family_id", "checks"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1},
    "pass_threshold": {"type": "number", "minimum": 0, "maximum": 100},
    "critical_failure_cap": {"type": "number", "minimum": 0, "maximum": 100},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "path", "kind", "weight"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string"},
          "kind": {"enum": ["exact", "set_contains", "set_excludes", "numeric_close", "nonempty", "boolean"]},
          "weight": {"type": "number", "exclusiveMinimum": 0},
          "critical": {"type": "boolean"},
          "absolute_tolerance": {"type": "number", "minimum": 0},
          "relative_tolerance": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}
