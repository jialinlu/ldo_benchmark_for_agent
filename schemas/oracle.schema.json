{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jialinlu/ldo_benchmark_for_agent/schemas/oracle.schema.json",
  "title": "EvoLDO-Bench deterministic oracle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "family_id", "checks"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1},
    "pass_threshold": {"type": "number", "minimum": 0, "maximum": 100},
    "critical_failure_cap": {"type": "number", "minimum": 0, "maximum": 100},
    "relevant_knowledge_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "path", "kind", "weight"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string"},
          "kind": {"enum": ["choice_credit", "exact", "ranking_pairwise", "sequence_alignment", "set_equals", "set_contains", "set_excludes", "set_f1", "numeric_close", "numeric_score", "numeric_range", "mapping_credit", "multilabel_mapping_credit", "nonempty", "boolean"]},
          "weight": {"type": "number", "exclusiveMinimum": 0},
          "critical": {"type": "boolean"},
          "dimension": {"type": "string", "minLength": 1},
          "credits": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "critical_credit_threshold": {"type": "number", "minimum": 0, "maximum": 1},
          "absolute_tolerance": {"type": "number", "minimum": 0},
          "relative_tolerance": {"type": "number", "minimum": 0},
          "full_tolerance": {"type": "number", "minimum": 0},
          "zero_tolerance": {"type": "number", "exclusiveMinimum": 0},
          "minimum": {"type": "number"},
          "maximum": {"type": "number"},
          "partial_minimum": {"type": "number"},
          "partial_maximum": {"type": "number"}
        }
      }
    }
  }
}
